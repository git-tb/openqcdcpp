Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MyPlus", "[", 
    RowBox[{"k_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", "x"}], "]"}], "^", "k"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MyHeavy", "[", "t_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"t", ">=", "0"}], ",", "1", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MyIntegrand", "[", 
   RowBox[{"v_", ",", "w_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"MyPlus", "[", 
     RowBox[{"0", ",", "v"}], "]"}], "*", 
    RowBox[{"MyPlus", "[", 
     RowBox[{"1", ",", "w"}], "]"}], "*", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"MyHeavy", "[", 
        RowBox[{
         RowBox[{"v", "*", "w"}], "-", "x"}], "]"}], "*", 
       RowBox[{
        RowBox[{"MyF", "[", 
         RowBox[{"x", "/", 
          RowBox[{"(", 
           RowBox[{"w", "*", "v"}], ")"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"w", "*", "v"}], ")"}]}]}], "\[IndentingNewLine]", "-", 
      RowBox[{
       RowBox[{"MyHeavy", "[", 
        RowBox[{"v", "-", "x"}], "]"}], "*", 
       RowBox[{
        RowBox[{"MyF", "[", 
         RowBox[{"x", "/", "v"}], "]"}], "/", 
        RowBox[{"(", "v", ")"}]}]}], "\[IndentingNewLine]", "-", 
      RowBox[{
       RowBox[{"MyHeavy", "[", 
        RowBox[{"w", "-", "x"}], "]"}], "*", 
       RowBox[{
        RowBox[{"MyF", "[", 
         RowBox[{"x", "/", "w"}], "]"}], "/", 
        RowBox[{"(", "w", ")"}]}]}], "\[IndentingNewLine]", "+", 
      RowBox[{"MyF", "[", "x", "]"}]}], "\[IndentingNewLine]", ")"}]}], "/.", 
   
   RowBox[{"x", "->", "0.5"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Cuhre", "[", 
  RowBox[{
   RowBox[{"MyIntegrand", "[", 
    RowBox[{"v", ",", "w"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"v", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Verbose", "->", "0"}], ",", 
   RowBox[{"MaxPoints", "->", "100000"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Vegas", "[", 
  RowBox[{
   RowBox[{"MyIntegrand", "[", 
    RowBox[{"v", ",", "w"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"v", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Verbose", "->", "0"}], ",", 
   RowBox[{"MaxPoints", "->", "100000"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Divonne", "[", 
  RowBox[{
   RowBox[{"MyIntegrand", "[", 
    RowBox[{"v", ",", "w"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"v", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Verbose", "->", "0"}], ",", 
   RowBox[{"MaxPoints", "->", "100000"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Suave", "[", 
  RowBox[{
   RowBox[{"MyIntegrand", "[", 
    RowBox[{"v", ",", "w"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"v", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"w", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Verbose", "->", "0"}], ",", 
   RowBox[{"MaxPoints", "->", "100000"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"NIntegrate", "[", 
